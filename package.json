{
  "name": "dsh-media-preview",
  "version": "1.0.0",
  "description": "Audio and video preview for dsh-better-sidebar in ONE plugin: two viewers over one shared Range route that keeps seeking working inside the Electron desktop shell",
  "type": "module",
  "license": "MIT",
  "author": "mengruoa",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "test"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-better-sidebar",
    "deepseek-harness",
    "audio",
    "video",
    "preview",
    "file-viewer",
    "http-range"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/route.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1
  }
}
